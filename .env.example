# --- OpenAI (leave OPENAI_API_KEY empty to run in demo mode with simulated AI) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini                 # triage reasoning
# OPENAI_VISION_MODEL=gpt-5-mini          # image diagnostics
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_REASONING_EFFORT=low             # optional, for reasoning models
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Access control: comma-separated role:token pairs (roles: chw, clinician, admin) ---
# Without this the app runs in OPEN DEVELOPMENT MODE (everyone has full access).
ACCESS_TOKENS=chw:change-me-chw,clinician:change-me-clinician

# --- Deployment ---
PORT=3000
EMERGENCY_NUMBER=112
# Describe the setting so the AI weighs local disease patterns:
REGION_CONTEXT=
# DB_PATH=./data/health-ai.db
# RATE_LIMIT_PER_MINUTE=30
# MOCK_AI=1
